# Copy to .env and fill in your own keys: cp .env.example .env
# .env is gitignored — never commit real keys.

# --- Required ---------------------------------------------------------------

# https://platform.openai.com — the agent runs on gpt-4o-mini, the eval judges
# on gpt-4o.
OPENAI_API_KEY=sk-...

# https://pinecone.io — required even if you skip ingestion, because the
# retriever authenticates before it can discover there is no index yet.
PINECONE_API_KEY=...

# Name of the Pinecone index. Created automatically on your first ingest run,
# via integrated inference (llama-text-embed-v2, dim 1024, cosine).
PINECONE_INDEX=llama-text-embed-v2-index

# https://tavily.com — live web search. This is the only source of context if
# you skip the ingestion step.
TAVILY_API_KEY=...

# development enables uvicorn auto-reload when starting through main.py.
APP_ENV=development

# --- Optional: LangSmith tracing --------------------------------------------
# Leave commented out to run without tracing.

# LANGSMITH_TRACING=true
# LANGSMITH_ENDPOINT=https://api.smith.langchain.com
# LANGSMITH_API_KEY=...
# LANGSMITH_PROJECT=ai-agent-researcher
